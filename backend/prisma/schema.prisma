generator client {
   provider = "prisma-client-js"
}

datasource db {
   provider = "mysql"
}

model Cliente {
   id_cliente Int @id @default(autoincrement())
   tipo String @db.VarChar(300)
   preco Decimal @db.Decimal(10,2)
   nome String @db.VarChar(100)
   cpf String @db.VarChar(14)
   telefone String @db.VarChar(20)
   email String @db.VarChar(100)
   endereco String @db.VarChar(150)
   data_cadastro Datetime @db.Date

   vendas Venda[]
   boleto Boleto[]
   servicos Servico[]
   
}

model Boleto {
  id_boleto Int @id @default(autoincrement())
  valor Decimal @db.Decimal(10,2)
  vencimento Datetime @db.Date
  status String @db.VarChar(30)

  id_clinte Int
  cliente Cliente @relation(fields:[id_cliente],references:[id_cliente])

}

model Administrador {
   id_administrador Int @id @default(autoincrement())
   nome String @db.VarChar(100)
   email String @db.VarChar(100)
   senha String @db.VarChar(255)
   perfil String @db.VarChar(50)
}

model Servico {
   id_servico Int @id @default(autoincrement())
   descricao String @db.VarChar(255)
   tipo_servico String @db.VarChar(100)
   data_agendamento Datetime @db.Date
   status String @db.VarChar(30)
   valor Decimal @db.Decimal(10,2)

   id_cliente Int
   cliente Cliente @relation(fields:[id_cliente],references:[id_cliente])

}

model Vendas {
   id_vendas Int @id @default(autoincrement())
   data_venda Datetime @db.Date
   valor_total Decimal @db.Decimal(10,2)

   id_cliente Int 
   cliente Cliente @relation(fields:[id_cliente], references:[id_cliente])

   itens_venda Item_Venda[]
}

model Item_Venda {
  id_item_venda Int @db @default(autoincrement())
  quantidade Int 
  valor_unitario Decimal @db.Decimal(10,2)

  id_venda Int
  venda  Venda @relation(fields:[id_venda],references:[id_venda])

  id_produto Int
  produto Produto @relation(fields:[id_produto],references:[id_produto])
}

model Produto {
   id_produto Int @id @default(autoincrement())
   nome String @db.VarChar(100)
   descricao String @db.VarChar(255)
   preco_venda Decimal @db.Decimal(10,2)
   quantidade_historico Int
   
   itensvenda ItemVenda[]
}